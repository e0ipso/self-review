{
  "name": "@self-review/config",
  "version": "2.1.0",
  "description": "Browser-safe configuration defaults and ownership factories for self-review",
  "repository": {
    "type": "git",
    "url": "https://github.com/e0ipso/self-review.git",
    "directory": "packages/config"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.9.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@self-review/types": "*"
  }
}
