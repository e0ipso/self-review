<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:sift:ticket:v1"
           xmlns:tns="urn:sift:ticket:v1"
           elementFormDefault="qualified">

  <!--
    <id> renders as YAML "id". The pattern accepts any digit run: the four-digit
    %04d minimum is the allocation and tracker-script rule, which this pattern does
    not enforce. XSD cannot bind <PREFIX> to the repository configuration.
  -->
  <xs:simpleType name="ticketId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z][A-Z0-9]*-[0-9]+" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="nonEmptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:pattern value="\s*\S[\s\S]*" />
    </xs:restriction>
  </xs:simpleType>

  <!--
    <status> renders as YAML "status". open | in-progress | blocked belong in open/;
    done | wontfix | superseded belong in archive/. XSD cannot inspect the ticket path.
  -->
  <xs:simpleType name="status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="open" />
      <xs:enumeration value="in-progress" />
      <xs:enumeration value="blocked" />
      <xs:enumeration value="done" />
      <xs:enumeration value="wontfix" />
      <xs:enumeration value="superseded" />
    </xs:restriction>
  </xs:simpleType>

  <!--
    <type> renders as YAML "type" and must match the category folder. XSD cannot
    inspect the ticket path.
  -->
  <xs:simpleType name="type">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bug" />
      <xs:enumeration value="hardening" />
      <xs:enumeration value="feature" />
      <xs:enumeration value="test" />
      <xs:enumeration value="docs" />
      <xs:enumeration value="dx" />
      <xs:enumeration value="release" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="priority">
    <xs:restriction base="xs:string">
      <xs:enumeration value="p1" />
      <xs:enumeration value="p2" />
      <xs:enumeration value="p3" />
      <xs:enumeration value="p4" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="effort">
    <xs:restriction base="xs:string">
      <xs:enumeration value="s" />
      <xs:enumeration value="m" />
      <xs:enumeration value="l" />
      <xs:enumeration value="xl" />
    </xs:restriction>
  </xs:simpleType>

  <!--
    <milestone> renders as YAML "milestone". It must be listed in MILESTONES.md and
    match the milestone folder. XSD cannot enforce either rule.
  -->
  <xs:simpleType name="milestone">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._-]*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="label">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*" />
    </xs:restriction>
  </xs:simpleType>

  <!--
    <front-matter> children render as same-name YAML keys in declaration order, except
    <depends-on> renders as "depends_on". Repeated <label> and <ticket> elements render
    as YAML lists.
  -->
  <xs:complexType name="frontMatter">
    <xs:sequence>
      <xs:element name="id" type="tns:ticketId" />
      <xs:element name="title" type="tns:nonEmptyString" />
      <xs:element name="status" type="tns:status" />
      <xs:element name="type" type="tns:type" />
      <xs:element name="milestone" type="tns:milestone" />
      <xs:element name="priority" type="tns:priority" />
      <xs:element name="effort" type="tns:effort" />
      <!--
        <wave> renders as YAML "wave". It is the ticket's wave membership, written
        at drafting time. Every open ticket carries one; an archived ticket keeps
        whatever wave it was drafted with, and the key is never required or edited
        after resolution. XSD cannot inspect the ticket path, and a draft is always
        open work, so the declaration here is unconditional.
      -->
      <xs:element name="wave" type="xs:positiveInteger" />
      <xs:element name="created" type="xs:date" />
      <xs:element name="updated" type="xs:date" />
      <xs:element name="labels" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="label" type="tns:label" maxOccurs="unbounded" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="depends-on" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ticket" type="tns:ticketId" maxOccurs="unbounded" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!--
        <resolution> is required and non-empty for terminal statuses. XSD cannot express
        this cross-field constraint.
      -->
      <xs:element name="resolution" type="tns:nonEmptyString" minOccurs="0" />
      <xs:element name="source" type="tns:nonEmptyString" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- Each <item> renders as one bullet under "## Evidence". -->
  <xs:complexType name="evidence">
    <xs:sequence>
      <xs:element name="item" type="tns:nonEmptyString" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- Each <criterion> renders as one "- [ ]" under "## Acceptance criteria". -->
  <xs:complexType name="acceptanceCriteria">
    <xs:sequence>
      <xs:element name="criterion" type="tns:nonEmptyString" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

</xs:schema>
