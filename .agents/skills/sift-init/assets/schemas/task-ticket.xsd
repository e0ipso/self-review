<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:sift:ticket:v1"
           xmlns:tns="urn:sift:ticket:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="sift-common.xsd" />

  <!--
    Element order is the rendered section order; do not reorder. Optional elements are
    omitted entirely when they do not apply.
  -->
  <xs:element name="task-ticket">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="front-matter" type="tns:frontMatter" />

        <!-- <description> renders as "## Problem". -->
        <xs:element name="description" type="tns:nonEmptyString" />

        <!-- <evidence> renders as "## Evidence". -->
        <xs:element name="evidence" type="tns:evidence" minOccurs="0" />

        <!-- <direction> renders as "## Direction". -->
        <xs:element name="direction" type="tns:nonEmptyString" minOccurs="0" />

        <!-- <acceptance-criteria> renders as "## Acceptance criteria". -->
        <xs:element name="acceptance-criteria" type="tns:acceptanceCriteria" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
